{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "signature": true
  },
  "globalDependencies": [".bun-version", "oxlint.config.ts"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/trails.config.ts"
      ],
      "outputs": [],
      "env": ["CI", "NODE_ENV", "TRAILS_ENV", "TZ"]
    },
    "@ontrails/library#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/trails.config.ts",
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/adapters/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/examples/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/.trails/**",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/.skillset/**",
        "$TURBO_ROOT$/plugin/**",
        "$TURBO_ROOT$/plugin-dev/**",
        "$TURBO_ROOT$/plugins/**",
        "$TURBO_ROOT$/skillset.yaml",
        "$TURBO_ROOT$/skillset.lock",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/node_modules/**",
        "!**/*.tsbuildinfo",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/.tmp-tests/**",
        "!$TURBO_ROOT$/apps/*/dist/**",
        "!$TURBO_ROOT$/apps/*/.turbo/**",
        "!$TURBO_ROOT$/apps/*/node_modules/**",
        "!$TURBO_ROOT$/apps/*/.tmp-tests/**",
        "!$TURBO_ROOT$/adapters/*/dist/**",
        "!$TURBO_ROOT$/adapters/*/.turbo/**",
        "!$TURBO_ROOT$/adapters/*/node_modules/**",
        "!$TURBO_ROOT$/adapters/*/.tmp-tests/**",
        "!$TURBO_ROOT$/examples/*/dist/**",
        "!$TURBO_ROOT$/examples/*/.turbo/**",
        "!$TURBO_ROOT$/examples/*/node_modules/**",
        "!$TURBO_ROOT$/examples/*/.tmp-tests/**"
      ],
      "env": ["CI", "NODE_ENV", "TRAILS_ENV", "TZ"],
      "outputs": []
    },
    "@ontrails/adapter-kit#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/trails.config.ts",
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/adapters/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/examples/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/.trails/**",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/.skillset/**",
        "$TURBO_ROOT$/plugin/**",
        "$TURBO_ROOT$/plugin-dev/**",
        "$TURBO_ROOT$/plugins/**",
        "$TURBO_ROOT$/skillset.yaml",
        "$TURBO_ROOT$/skillset.lock",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/node_modules/**",
        "!**/*.tsbuildinfo",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/.tmp-tests/**",
        "!$TURBO_ROOT$/apps/*/dist/**",
        "!$TURBO_ROOT$/apps/*/.turbo/**",
        "!$TURBO_ROOT$/apps/*/node_modules/**",
        "!$TURBO_ROOT$/apps/*/.tmp-tests/**",
        "!$TURBO_ROOT$/adapters/*/dist/**",
        "!$TURBO_ROOT$/adapters/*/.turbo/**",
        "!$TURBO_ROOT$/adapters/*/node_modules/**",
        "!$TURBO_ROOT$/adapters/*/.tmp-tests/**",
        "!$TURBO_ROOT$/examples/*/dist/**",
        "!$TURBO_ROOT$/examples/*/.turbo/**",
        "!$TURBO_ROOT$/examples/*/node_modules/**",
        "!$TURBO_ROOT$/examples/*/.tmp-tests/**"
      ],
      "env": ["CI", "NODE_ENV", "TRAILS_ENV", "TZ"],
      "outputs": []
    },
    "@ontrails/warden#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/trails.config.ts",
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/adapters/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/examples/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/.trails/**",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/.skillset/**",
        "$TURBO_ROOT$/plugin/**",
        "$TURBO_ROOT$/plugin-dev/**",
        "$TURBO_ROOT$/plugins/**",
        "$TURBO_ROOT$/skillset.yaml",
        "$TURBO_ROOT$/skillset.lock",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/node_modules/**",
        "!**/*.tsbuildinfo",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/.tmp-tests/**",
        "!$TURBO_ROOT$/apps/*/dist/**",
        "!$TURBO_ROOT$/apps/*/.turbo/**",
        "!$TURBO_ROOT$/apps/*/node_modules/**",
        "!$TURBO_ROOT$/apps/*/.tmp-tests/**",
        "!$TURBO_ROOT$/adapters/*/dist/**",
        "!$TURBO_ROOT$/adapters/*/.turbo/**",
        "!$TURBO_ROOT$/adapters/*/node_modules/**",
        "!$TURBO_ROOT$/adapters/*/.tmp-tests/**",
        "!$TURBO_ROOT$/examples/*/dist/**",
        "!$TURBO_ROOT$/examples/*/.turbo/**",
        "!$TURBO_ROOT$/examples/*/node_modules/**",
        "!$TURBO_ROOT$/examples/*/.tmp-tests/**"
      ],
      "env": ["CI", "NODE_ENV", "TRAILS_ENV", "TZ"],
      "outputs": []
    },
    "@ontrails/trails#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/trails.config.ts",
        "$TURBO_ROOT$/*.md",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/adapters/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/examples/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/.trails/**",
        "$TURBO_ROOT$/.changeset/**",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/.skillset/**",
        "$TURBO_ROOT$/plugin/**",
        "$TURBO_ROOT$/plugin-dev/**",
        "$TURBO_ROOT$/plugins/**",
        "$TURBO_ROOT$/skillset.yaml",
        "$TURBO_ROOT$/skillset.lock",
        "!**/dist/**",
        "!**/.turbo/**",
        "!**/node_modules/**",
        "!**/*.tsbuildinfo",
        "!$TURBO_ROOT$/packages/*/dist/**",
        "!$TURBO_ROOT$/packages/*/.turbo/**",
        "!$TURBO_ROOT$/packages/*/node_modules/**",
        "!$TURBO_ROOT$/packages/*/.tmp-tests/**",
        "!$TURBO_ROOT$/apps/*/dist/**",
        "!$TURBO_ROOT$/apps/*/.turbo/**",
        "!$TURBO_ROOT$/apps/*/node_modules/**",
        "!$TURBO_ROOT$/apps/*/.tmp-tests/**",
        "!$TURBO_ROOT$/adapters/*/dist/**",
        "!$TURBO_ROOT$/adapters/*/.turbo/**",
        "!$TURBO_ROOT$/adapters/*/node_modules/**",
        "!$TURBO_ROOT$/adapters/*/.tmp-tests/**",
        "!$TURBO_ROOT$/examples/*/dist/**",
        "!$TURBO_ROOT$/examples/*/.turbo/**",
        "!$TURBO_ROOT$/examples/*/node_modules/**",
        "!$TURBO_ROOT$/examples/*/.tmp-tests/**"
      ],
      "env": ["CI", "NODE_ENV", "TRAILS_ENV", "TZ"],
      "outputs": []
    },
    "@ontrails/regrade#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/trails.config.ts",
        "$TURBO_ROOT$/examples/packlist/src/app.ts",
        "$TURBO_ROOT$/apps/trails/src/app.ts"
      ],
      "env": ["CI", "NODE_ENV", "TRAILS_ENV", "TZ"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["@ontrails/oxlint-plugin#build"],
      "inputs": ["src/**"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
