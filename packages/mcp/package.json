{
  "name": "@ontrails/mcp",
  "version": "0.2.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outfitter-dev/trails.git",
    "directory": "packages/mcp"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/__tests__/**",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fetch": "./src/fetch.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
