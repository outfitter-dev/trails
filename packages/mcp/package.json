  },
  "dependencies": {
    "@ontrails/core": "workspace:^"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "hono": "^4.13.13"
  },
  "peerDependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "catalog:"
  }
